#!/bin/sh
#
# 校园网认证 —— mwan3 热插拔事件响应 (单线多拨版)
# 接口下线时, 调用主脚本对该接口重新认证。
# 前提: /usr/bin/campus_auth.py 中 INTERFACES 的 name 与 mwan3 接口名一致。
#      主脚本会自动跳过非校园网接口, 且 login 幂等, 无需额外防护。

AUTH="/usr/bin/campus_auth.py"

case "$ACTION" in
    disconnected|ifdown)
        logger -t mwan3.campus "$ACTION on $INTERFACE ($DEVICE), re-auth"
        python3 "$AUTH" login "$INTERFACE" >>/tmp/campus_auth.log 2>&1 &
        ;;
esac

exit 0
